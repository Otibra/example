def get_number(prompt):
    while True:
        try:
            return float(input(prompt))
        except ValueError:
            print("Invalid number, please enter a valid number.")


def cal():
    num1 = get_number("Enter your first number: ")
    num2 = get_number("Enter your second number: ")

    while True:
        operator = input("Enter operator (-, +, *, /): ")

        if operator == '-':
            return num1 - num2
        elif operator == '+':
            return num1 + num2
        elif operator == '*':
            return num1 * num2 
        elif operator == '/':
            if num2 == 0:
                print("Cannot divide by zero.")
                num2 = get_number("Enter second number again: ")
                continue
            return num1 / num2
        else:
            print("Invalid operator, enter operator again.")


while True:
    result = cal()
    print("Result:", result)

    choice = input("Do you want to continue? (yes/no): ").lower()
    if choice == 'no':
        print("Exiting calculator...")
        break
    